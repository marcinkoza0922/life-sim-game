                (label: "Press it", check: (Mischief, 5.0), success: [Performance(20.0), Moodlet("evil_triumph"), Log("It turned all the lair's bananas slightly blue. Terrifying.")], failure: [Performance(-15.0), Moodlet("embarrassed")]),
