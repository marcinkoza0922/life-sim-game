// Rabbit-hole careers. Each shift fires one event; `check` is (skill, difficulty 0-10).
// Event text may use {name}. Spy track text gets random [REDACTED] words.
[
    (
        id: "culinary", name: "Culinary", desc: "From the dish pit to the Michelin-ish stars.",
        levels: [
            (title: "Dishwasher", pay: 14, start_hour: 16, hours: 6, days: [0, 1, 2, 3, 4]),
            (title: "Line Cook", pay: 20, start_hour: 15, hours: 7, days: [0, 1, 2, 3, 4], skills: {Cooking: 2.0}),
            (title: "Sous Chef", pay: 30, start_hour: 14, hours: 8, days: [1, 2, 3, 4, 5], skills: {Cooking: 4.0}),
            (title: "Head Chef", pay: 45, start_hour: 14, hours: 8, days: [1, 2, 3, 4, 5], skills: {Cooking: 6.0, Charisma: 2.0}),
            (title: "Celebrity Chef Who Yells", pay: 80, start_hour: 12, hours: 6, days: [2, 3, 4, 5], skills: {Cooking: 8.0, Charisma: 5.0}),
        ],
        events: [
            (text: "A food critic orders 'whatever the chef recommends.' The chef recommends {name} figure it out.",
             choices: [
                (label: "Improvise a masterpiece", check: (Cooking, 4.0),
                 success: [Performance(15.0), Moodlet("good_day_at_work")], failure: [Performance(-10.0), Log("The critic described the dish as 'brave.'")]),
                (label: "Serve a very nice sandwich", success: [Performance(2.0)]),
             ]),
            (text: "The walk-in freezer door is stuck and {name} is on the inside.",
             choices: [
                (label: "Wait patiently", success: [Performance(-5.0), Log("{name} was rescued four hours later, holding a frozen fish for warmth.")]),
                (label: "MacGyver the latch", check: (Handiness, 3.0), success: [Performance(5.0), Skill(Handiness, 0.5)], failure: [Moodlet("embarrassed")]),
             ]),
            (text: "A customer sends back their water for being 'too wet.'",
             choices: [
                (label: "Pour it into a fancier glass", check: (Charisma, 2.0), success: [Performance(8.0), Log("The customer declared it 'much better.'")], failure: [Performance(-4.0)]),
                (label: "Explain water", success: [Performance(-8.0), Moodlet("bad_day_at_work")]),
             ]),
        ],
    ),
    (
