// Traits change need decay (`decay` multipliers), how much interactions with a tag appeal (`tags`),
// and may grant a personality need (`grants`). Silly needs are deliberately low-weight in autonomy.
[
    (id: "neat", name: "Neat", desc: "Alphabetizes the spice rack. Then the spoons.",
     tags: {"neat": 2.5, "chore": 1.8, "gross": 0.2}, decay: {Environment: 1.5}, conflicts: ["slob"]),
    (id: "slob", name: "Slob", desc: "Believes dishes clean themselves if you believe hard enough.",
     tags: {"chore": 0.3, "neat": 0.2, "gross": 1.5, "lazy": 1.3}, decay: {Hygiene: 1.3, Environment: 0.5}, conflicts: ["neat"]),
    (id: "lazy", name: "Lazy", desc: "Has elevated lying down to an art form.",
     tags: {"lazy": 2.0, "rest": 1.6, "exercise": 0.15, "chore": 0.5}, decay: {Energy: 1.2, Comfort: 1.3}, conflicts: ["active"]),
    (id: "active", name: "Active", desc: "Does lunges while waiting for the microwave.",
     tags: {"exercise": 2.5, "lazy": 0.4, "rest": 0.7}, decay: {Fun: 1.2, Energy: 0.9}, conflicts: ["lazy"]),
    (id: "romantic", name: "Romantic", desc: "Has already named your future children.",
     tags: {"romance": 2.5}, decay: {Social: 1.2}),
    (id: "paranoid", name: "Paranoid", desc: "The birds know. The birds have always known.",
     tags: {"paranoid": 2.0, "social": 0.8}, grants: Vigilance),
    (id: "theatrical", name: "Theatrical", desc: "Every room is a stage. Every toaster an audience.",
     tags: {"drama": 2.2, "social": 1.2}, grants: Drama),
    (id: "vain", name: "Vain", desc: "Owns more mirrors than plates.",
     tags: {"vain": 2.5}, decay: {Hygiene: 1.2}, grants: Validation),
    (id: "gremlin", name: "Gremlin", desc: "Chaotic neutral. Mostly chaotic.",
     tags: {"mischief": 2.5, "gross": 1.5, "neat": 0.3}, grants: Chaos, conflicts: ["neat"]),
    (id: "bookish", name: "Bookish", desc: "Narrates their own life in the third person. Quietly. Usually.",
     tags: {"learning": 2.0, "quiet": 1.6, "screen": 0.7}, grants: Narration),
    (id: "foodie", name: "Foodie", desc: "Will describe a sandwich's 'mouthfeel' unprompted.",
     tags: {"food": 1.4, "cooking": 2.2}, decay: {Hunger: 1.25}),
    (id: "hothead", name: "Hothead", desc: "Has argued with a GPS. Won.",
     tags: {"mean": 2.0, "quiet": 0.6}, conflicts: ["cheerful"]),
    (id: "cheerful", name: "Cheerful", desc: "Unsettlingly upbeat before coffee.",
     tags: {"fun": 1.3, "mean": 0.3, "social": 1.3}, decay: {Fun: 0.8}, conflicts: ["gloomy", "hothead"]),
    (id: "gloomy", name: "Gloomy", desc: "Prefers their weather overcast and their poetry bleak.",
     tags: {"fun": 0.7, "quiet": 1.4, "drama": 1.2}, decay: {Fun: 1.2}, conflicts: ["cheerful"]),
    (id: "night_owl", name: "Night Owl", desc: "Sleep is for people who don't have browser tabs open.",
     tags: {"sleep": 0.7, "screen": 1.5}, decay: {Energy: 0.85}),
    (id: "clumsy", name: "Clumsy", desc: "Has tripped over a cordless phone.",
     tags: {"repair": 0.6}),
    (id: "loner", name: "Loner", desc: "Enjoys people in small, infrequent doses.",
     tags: {"social": 0.5, "quiet": 1.7}, decay: {Social: 0.6}, conflicts: ["social_butterfly"]),
    (id: "social_butterfly", name: "Social Butterfly", desc: "Has never met a stranger, only friends who don't know it yet.",
     tags: {"social": 2.0, "quiet": 0.6}, decay: {Social: 1.5}, conflicts: ["loner"]),
    (id: "creative", name: "Creative", desc: "Sees art in everything, especially things that are not art.",
     tags: {"creative": 2.2, "art": 2.0}),
    (id: "handy", name: "Handy", desc: "Fixes things. Occasionally things that weren't broken.",
     tags: {"repair": 2.5, "chore": 1.2}),
]
